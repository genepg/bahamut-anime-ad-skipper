{
  "compilerOptions": {
    // Content scripts are loaded as classic scripts by the manifest, not as ES
    // modules — "none" makes tsc reject any import/export that would break that.
    "module": "none",
    "target": "ES2021",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "types": ["chrome"],

    "rootDir": "src",
    "outDir": "dist",
    "removeComments": false,
    "newLine": "lf",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": false,
    "skipLibCheck": true
  },
  "include": ["src"]
}
